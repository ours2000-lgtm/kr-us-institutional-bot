@echo off
chcp 65001 >nul

echo =========================================================
echo      한국 자동매매 V5 PLUS — 스케줄러 자동 등록
echo =========================================================

REM ---------------------------------------------------------
REM 기존 스케줄 삭제 (중복 방지)
REM ---------------------------------------------------------
schtasks /delete /tn "KR_START_V5" /f >nul 2>&1
schtasks /delete /tn "KR_STOP_V5" /f >nul 2>&1

echo 이전 스케줄 제거 완료...

REM ---------------------------------------------------------
REM 매일 08:55 자동 시작
REM ---------------------------------------------------------
schtasks /create ^
 /tn "KR_START_V5" ^
 /tr "E:\KR_US_INSTITUTIONAL_BOT\korea\KR_START_V5.bat" ^
 /sc daily ^
 /st 08:55 ^
 /rl highest

echo 한국 자동매매 — 08:55 자동 시작 등록 완료


REM ---------------------------------------------------------
REM 매일 15:40 자동 종료
REM ---------------------------------------------------------
schtasks /create ^
 /tn "KR_STOP_V5" ^
 /tr "taskkill /im python.exe /f" ^
 /sc daily ^
 /st 15:40 ^
 /rl highest

echo 한국 자동매매 — 15:40 자동 종료 등록 완료

echo ---------------------------------------------------------
echo   한국 V5 PLUS 자동 스케줄 등록 완료!
echo   매일 08:55 자동 실행 → 15:40 자동 종료
echo ---------------------------------------------------------
pause
