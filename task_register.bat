@echo off
chcp 65001 >nul
echo ================================
echo   한국/미국 자동매매 스케줄 등록
echo ================================

set ROOT=E:\KR_US_INSTITUTIONAL_BOT

REM ============================================================
REM 한국 자동매매 시작 (매일 08:55)
REM ============================================================
schtasks /create /tn "KR_START" /tr "%ROOT%\KR_START_0855.bat" /sc daily /st 08:55 /rl highest /f

REM ============================================================
REM 한국 자동매매 종료 (매일 15:40)
REM ============================================================
schtasks /create /tn "KR_STOP" /tr "%ROOT%\KR_STOP_1540.bat" /sc daily /st 15:40 /rl highest /f

REM ============================================================
REM 미국 자동매매 시작 (매일 23:25)
REM ============================================================
schtasks /create /tn "US_START" /tr "%ROOT%\US_START_2325.bat" /sc daily /st 23:25 /rl highest /f

REM ============================================================
REM 미국 자동매매 종료 (매일 06:05)
REM ============================================================
schtasks /create /tn "US_STOP" /tr "%ROOT%\US_STOP_0605.bat" /sc daily /st 06:05 /rl highest /f

echo ------------------------------------------
echo  스케줄 등록 완료! (Windows 작업 스케줄러)
echo ------------------------------------------
pause
