@echo off
chcp 65001 >nul

echo ==============================================
echo   미국 자동매매 V5 PLUS 스케줄러 등록 시작
echo ==============================================

REM --------------------------------------------------------------
REM 스케줄 등록 전 기존 동일 이름 작업 삭제
REM --------------------------------------------------------------
schtasks /Delete /TN "US_AUTO_V5_START" /F >nul 2>&1
schtasks /Delete /TN "US_AUTO_V5_STOP" /F >nul 2>&1

REM --------------------------------------------------------------
REM ★ 자동 시작 (23:25) ★
REM run_us_v5_plus.py 를 실행하는 START 배치파일 호출
REM --------------------------------------------------------------
schtasks /Create ^
 /SC DAILY ^
 /TN "US_AUTO_V5_START" ^
 /TR "\"E:\KR_US_INSTITUTIONAL_BOT\usa\US_START_V5.bat\"" ^
 /ST 23:25 ^
 /RL HIGHEST

echo [등록 완료] 미국 자동매매 시작(23:25)

REM --------------------------------------------------------------
REM ★ 자동 종료 (06:10) ★
REM 파이썬 프로세스를 종료시켜 자동 종료 처리
REM --------------------------------------------------------------
schtasks /Create ^
 /SC DAILY ^
 /TN "US_AUTO_V5_STOP" ^
 /TR "taskkill /IM python.exe /F" ^
 /ST 06:10 ^
 /RL HIGHEST

echo [등록 완료] 미국 자동매매 종료(06:10)

echo ==============================================
echo   미국 자동매매 V5 PLUS 스케줄러 등록 완료
echo ==============================================
pause
