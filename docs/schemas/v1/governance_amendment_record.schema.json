{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/v1/governance_amendment_record.schema.json",
  "title": "GOVERNANCE_AMENDMENT_RECORD",
  "allOf": [
    { "$ref": "evidence_core.schema.json" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "payload"],
      "properties": {
        "evidence_type": { "const": "GOVERNANCE_AMENDMENT_RECORD" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "amendment_id",
            "domain",
            "revision",
            "stage",
            "proposal_version",
            "proposer"
          ],
          "properties": {
            "amendment_id": {
              "type": "string",
              "pattern": "^AMEND-(GOVERNANCE|EVIDENCE|SCHEMA|POLICY)-REV\\d+\\.\\d+-\\d{4}$"
            },
            "domain": {
              "type": "string",
              "enum": ["GOVERNANCE", "EVIDENCE", "SCHEMA", "POLICY"]
            },
            "revision": {
              "type": "string",
              "pattern": "^REV\\d+\\.\\d+$"
            },
            "proposal_version": { "type": "string" },
            "stage": {
              "type": "string",
              "enum": [
                "DRAFT",
                "UNDER_REVIEW",
                "REQUEST_CHANGES",
                "BLOCKED",
                "APPROVED_PENDING_RATIFICATION",
                "WITHDRAWN",
                "SUPERSEDED"
              ]
            },
            "proposer": {
              "type": "object",
              "additionalProperties": false,
              "required": ["proposer_id", "roles"],
              "properties": {
                "proposer_id": { "type": "string" },
                "roles": { "type": "array", "minItems": 1, "items": { "type": "string" } }
              }
            },
            "discussion_thread_ref": { "type": "string" },
            "change_requests": { "type": "array", "items": { "type": "string" } },
            "targets": { "type": "array", "items": { "type": "string" } },
            "evidence_refs": { "type": "array", "items": { "type": "string" } },
            "evidence_pack_ref": { "type": "string" }
          }
        }
      }
    }
  ]
}
