{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/v1/governance_ratification_record.schema.json",
  "title": "GOVERNANCE_RATIFICATION_RECORD",
  "allOf": [
    { "$ref": "evidence_core.schema.json" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "payload"],
      "properties": {
        "evidence_type": { "const": "GOVERNANCE_RATIFICATION_RECORD" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ratification_id",
            "amendment_id",
            "domain",
            "revision",
            "ratification_tag",
            "commit_hash",
            "ratifying_authority",
            "approvals",
            "decision",
            "decision_timestamp_utc"
          ],
          "properties": {
            "ratification_id": {
              "type": "string",
              "pattern": "^RATIFY-(GOVERNANCE|EVIDENCE|SCHEMA|POLICY)-REV\\d+\\.\\d+-\\d{8}-\\d{4}$"
            },
            "amendment_id": {
              "type": "string",
              "pattern": "^AMEND-(GOVERNANCE|EVIDENCE|SCHEMA|POLICY)-REV\\d+\\.\\d+-\\d{4}$"
            },
            "domain": { "type": "string", "enum": ["GOVERNANCE", "EVIDENCE", "SCHEMA", "POLICY"] },
            "revision": { "type": "string", "pattern": "^REV\\d+\\.\\d+$" },
            "ratification_tag": {
              "type": "string",
              "pattern": "^AMENDMENT-[A-Z]+-v\\d+\\.\\d+-\\d{8}(-[a-f0-9]{6,8})?-RATIFIED$"
            },
            "commit_hash": { "type": "string", "pattern": "^[a-f0-9]{7,40}$" },
            "ratifying_authority": {
              "type": "object",
              "additionalProperties": false,
              "required": ["authority_id", "authority_role"],
              "properties": {
                "authority_id": { "type": "string" },
                "authority_role": { "type": "string" }
              }
            },
            "approvals": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["reviewer_id", "role", "decision", "decided_at_utc"],
                "properties": {
                  "reviewer_id": { "type": "string" },
                  "role": { "type": "string" },
                  "decision": { "type": "string", "enum": ["APPROVE"] },
                  "decided_at_utc": { "type": "string", "format": "date-time" },
                  "reason_codes": { "type": "array", "items": { "type": "string" } }
                }
              }
            },
            "decision": { "type": "string", "enum": ["APPROVED"] },
            "decision_timestamp_utc": { "type": "string", "format": "date-time" },
            "evidence_refs": { "type": "array", "items": { "type": "string" } },
            "evidence_pack_ref": { "type": "string" }
          }
        }
      }
    }
  ]
}
