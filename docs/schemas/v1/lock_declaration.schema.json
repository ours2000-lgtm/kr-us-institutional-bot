{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "schemas/v1/lock_declaration.schema.json",
  "title": "LOCK_DECLARATION",
  "allOf": [
    { "$ref": "evidence_core.schema.json" },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_type", "payload"],
      "properties": {
        "evidence_type": { "const": "LOCK_DECLARATION" },
        "payload": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lock_id", "decision_class", "lock_timestamp_utc", "evidence_refs"],
          "properties": {
            "lock_id": { "type": "string" },
            "decision_class": { "type": "string", "enum": ["ALLOW", "BLOCK", "FAIL_CLOSED"] },
            "lock_timestamp_utc": { "type": "string", "format": "date-time" },
            "evidence_refs": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string" },
              "description": "Evidence IDs that justify the LOCK decision. MUST be stable identifiers."
            },
            "policy_id": { "type": "string" },
            "rejection_reason": { "type": "string" }
          }
        }
      }
    }
  ]
}
